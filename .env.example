# Public Supabase credentials — safe to expose in a Vite client app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: set to true only after the migration in supabase/migrations has been applied.
VITE_USE_SUPABASE=false
VITE_X_DATA_FUNCTION_URL=https://your-project.supabase.co/functions/v1/x-data
