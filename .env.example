# Frontend API
VITE_API_URL=http://localhost:8787

# Supabase Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only X credentials. Never expose these with VITE_ variables.
X_BEARER_TOKEN=your-x-bearer-token
X_USER_ACCESS_TOKEN=your-x-user-access-token
X_CLIENT_ID=your-x-oauth-client-id
X_CLIENT_SECRET=your-x-oauth-client-secret
X_REDIRECT_URI=http://localhost:8787/api/auth/x/callback
WEB_URL=http://localhost:5173
PORT=8787
